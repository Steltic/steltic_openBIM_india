{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Steltic openBIM India physical design handoff 1.0",
  "type":"object",
  "required":["schema_version","project","levels","grids","materials","profiles","members"],
  "properties":{
    "schema_version":{"const":"1.0"},
    "project":{"type":"object","required":["id","name","module","units"],"properties":{
      "id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/id"},"module":{"enum":["HR","CFS"]},"units":{"const":"mm"},
      "design_basis":{"$ref":"#/$defs/strings"},"design_status":{"enum":["pass","review","fail"]}}},
    "levels":{"type":"array","minItems":1,"items":{"type":"object","required":["id","elevation_mm"],
      "properties":{"id":{"$ref":"#/$defs/id"},"elevation_mm":{"type":"number"}}}},
    "grids":{"type":"object","required":["x","y"],"properties":{"x":{"$ref":"#/$defs/grids"},"y":{"$ref":"#/$defs/grids"}}},
    "materials":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","required":["grade","standard"],
      "properties":{"grade":{"$ref":"#/$defs/id"},"standard":{"$ref":"#/$defs/id"},"fy_mpa":{"$ref":"#/$defs/thickness"}}}},
    "profiles":{"type":"object","minProperties":1,"additionalProperties":{"type":"object","required":["family"],
      "properties":{"family":{"enum":["I","C","Z","L","RHS","CHS","ROD","PLATE","POLYGON"]},
        "dimensions_mm":{"type":"object","additionalProperties":{"type":"number"}},
        "contours_mm":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/ring2"}},
        "holes_mm":{"type":"array","items":{"type":"array","items":{"$ref":"#/$defs/ring2"}}}},
      "anyOf":[{"required":["dimensions_mm"]},{"required":["contours_mm"]}]}},
    "members":{"type":"array","minItems":1,"items":{"type":"object","required":["id","role","profile","material","start","end"],
      "properties":{"id":{"$ref":"#/$defs/id"},"role":{"$ref":"#/$defs/id"},"profile":{"$ref":"#/$defs/id"},
        "end_profile":{"$ref":"#/$defs/id"},"material":{"$ref":"#/$defs/id"},"start":{"$ref":"#/$defs/p3"},
        "end":{"$ref":"#/$defs/p3"},"ref_direction":{"$ref":"#/$defs/p3"},"unit":{"$ref":"#/$defs/id"},
        "end_cutbacks_mm":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number","minimum":0}},
        "member_voids":{"type":"array","items":{"type":"object","required":["id","kind"],"properties":{
          "id":{"$ref":"#/$defs/id"},"connection":{"$ref":"#/$defs/id"},"start":{"$ref":"#/$defs/p3"},"end":{"$ref":"#/$defs/p3"},
          "diameter_mm":{"$ref":"#/$defs/thickness"},"outline":{"$ref":"#/$defs/ring3"},"thickness_mm":{"$ref":"#/$defs/thickness"},
          "openings":{"type":"array","items":{"$ref":"#/$defs/ring3"}}},"oneOf":[
            {"properties":{"kind":{"const":"bore"}},"required":["start","end","diameter_mm"]},
            {"properties":{"kind":{"const":"slot"}},"required":["outline","thickness_mm"]}]}},
        "level":{"$ref":"#/$defs/id"},"checks":{"$ref":"#/$defs/ids"}}}},
    "panels":{"type":"array","items":{"allOf":[{"$ref":"#/$defs/plate"},{"type":"object","required":["role"],
      "properties":{"role":{"$ref":"#/$defs/id"},"level":{"$ref":"#/$defs/id"},"unit":{"$ref":"#/$defs/id"},"checks":{"$ref":"#/$defs/ids"}}}]}},
    "checks":{"type":"array","items":{"type":"object","required":["id","description","status"],
      "properties":{"id":{"$ref":"#/$defs/id"},"description":{"$ref":"#/$defs/id"},"status":{"enum":["pass","fail","review"]},
        "utilization":{"type":["number","null"],"minimum":0},"reference":{"type":"string"}}}},
    "connections":{"type":"array","items":{"type":"object","required":["id","type","at","members"],"properties":{
      "id":{"$ref":"#/$defs/id"},"type":{"$ref":"#/$defs/id"},"at":{"$ref":"#/$defs/p3"},"members":{"allOf":[{"$ref":"#/$defs/ids"},{"minItems":1}]},
      "checks":{"$ref":"#/$defs/ids"},"parameters":{"type":"object"},"description":{"type":"string"},
      "unit":{"$ref":"#/$defs/id"},"level":{"$ref":"#/$defs/id"},"parts":{"type":"array","items":{"oneOf":[
        {"allOf":[{"$ref":"#/$defs/plate"},{"required":["kind"],"properties":{"kind":{"const":"plate"}}}]},
        {"allOf":[{"$ref":"#/$defs/linearPart"},{"required":["diameter_mm"],"properties":{"kind":{"const":"bolt"},"diameter_mm":{"$ref":"#/$defs/thickness"}}}]},
        {"allOf":[{"$ref":"#/$defs/linearPart"},{"properties":{"kind":{"const":"weld"}},"oneOf":[
          {"required":["leg_mm"],"properties":{"weld_type":{"const":"fillet"},"leg_mm":{"$ref":"#/$defs/thickness"}},"not":{"anyOf":[{"required":["throat_mm"]},{"required":["width_mm"]}]}},
          {"required":["weld_type","throat_mm"],"properties":{"weld_type":{"const":"cjp"},"throat_mm":{"$ref":"#/$defs/thickness"},"width_mm":{"$ref":"#/$defs/thickness"}},"not":{"required":["leg_mm"]}}
        ]}]}
      ]}}}}},
    "assumptions":{"$ref":"#/$defs/strings"},
    "units":{"type":"array","items":{"type":"object","required":["id","name","origin_mm"],
      "properties":{"id":{"$ref":"#/$defs/id"},"name":{"$ref":"#/$defs/id"},"origin_mm":{"$ref":"#/$defs/p3"},"levels":{"$ref":"#/$defs/ids"}}}},
    "separation_joints":{"type":"array","items":{"type":"object","required":["id","units","axis"],
      "properties":{"id":{"$ref":"#/$defs/id"},"units":{"allOf":[{"$ref":"#/$defs/ids"},{"minItems":2,"maxItems":2}]},
        "axis":{"enum":["x","y"]},"direction":{"enum":[1,-1]},"declared_gap_mm":{"type":"number","minimum":0},
        "declared_basis":{"enum":["clear","workline"]},"required_gap_mm":{"type":"number","minimum":0},
        "stations_mm":{"$ref":"#/$defs/p2"},"elevation_range_mm":{"$ref":"#/$defs/p2"},"reference":{"type":"string"}}}}
  },
  "$defs":{
    "id":{"type":"string","minLength":1},
    "thickness":{"type":"number","exclusiveMinimum":0},
    "strings":{"type":"array","items":{"type":"string","minLength":1}},
    "ids":{"type":"array","uniqueItems":true,"items":{"$ref":"#/$defs/id"}},
    "p2":{"type":"array","minItems":2,"maxItems":2,"items":{"type":"number"}},
    "p3":{"type":"array","minItems":3,"maxItems":3,"items":{"type":"number"}},
    "ring2":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/p2"}},
    "ring3":{"type":"array","minItems":3,"items":{"$ref":"#/$defs/p3"}},
    "grids":{"type":"array","minItems":1,"items":{"type":"object","required":["id","coordinate_mm"],"properties":{"id":{"$ref":"#/$defs/id"},"coordinate_mm":{"type":"number"}}}},
    "plate":{"type":"object","required":["id","material","outline","thickness_mm"],"properties":{"id":{"$ref":"#/$defs/id"},"material":{"$ref":"#/$defs/id"},
      "outline":{"$ref":"#/$defs/ring3"},"thickness_mm":{"$ref":"#/$defs/thickness"},"openings":{"type":"array","items":{"$ref":"#/$defs/ring3"}}}},
    "linearPart":{"type":"object","required":["id","kind","material","start","end"],"properties":{"id":{"$ref":"#/$defs/id"},"material":{"$ref":"#/$defs/id"},
      "kind":{"enum":["bolt","weld"]},"start":{"$ref":"#/$defs/p3"},"end":{"$ref":"#/$defs/p3"},"ref_direction":{"$ref":"#/$defs/p3"}}}
  }
}
